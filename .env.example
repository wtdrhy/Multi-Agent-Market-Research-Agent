# DeepSeek API Key（必填）申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Tavily 联网搜索 Key（可选）申请：https://tavily.com
# 留空则调研/分析工人退化为纯模型知识，不影响运行
TAVILY_API_KEY=

# LangSmith 链路追踪（可选）申请：https://smith.langchain.com
# 填入后每次图执行的节点调用、耗时、token 用量都会记录到 LangSmith 控制台
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=market-research-agent
